{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarik",
  "version": "0.1.0",
  "identifier": "com.tarik.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tarik",
        "width": 800,
        "height": 600,
        "backgroundColor": "#e9edeb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Tarik contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first DuckDB SQL workbench",
    "longDescription": "A local-first desktop SQL workbench for learning, querying, explaining, and exporting local CSV, Parquet, and DuckDB data.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/release/COMPATIBILITY.md": "COMPATIBILITY.md",
      "../docs/agent-skills/tarik-mcp/SKILL.md": "agent-skills/tarik-mcp/SKILL.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
