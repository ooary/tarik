#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATUS_FILE="${SCRIPT_DIR}/status.json"

if [[ -L "${STATUS_FILE}" ]]; then
  printf '%s\n' '{"schemaVersion":1,"project":"Tarik","state":"failed","summary":"Status file must not be a symbolic link","needsUserReview":true}'
  exit 1
fi

if [[ ! -f "${STATUS_FILE}" ]]; then
  printf '%s\n' '{"schemaVersion":1,"project":"Tarik","state":"unknown","summary":"No status has been published yet","needsUserReview":false}'
  exit 0
fi

cat -- "${STATUS_FILE}"
